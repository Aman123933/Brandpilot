# Database connection URL (defaults to local SQLite if unset, e.g., postgresql://user:pass@host:5432/dbname for Supabase)
DATABASE_URL=

# Google Gemini API key for AI-assisted claim audit and red-team simulation (optional, falls back to deterministic rules if unset)
GEMINI_API_KEY=

# Gemini model identifier (set your preferred model from Google AI Studio)
GEMINI_MODEL=gemini-3.8-flash

# Fallback Gemini models to retry on 503/429/timeout (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# Per-call timeout for Gemini API calls in seconds (default: 30)
GEMINI_TIMEOUT_SECONDS=30

# Secret key for signing demo JWT authentication tokens
SECRET_KEY=change-this-to-a-secure-secret-key-in-production

# Public base URL of the deployment (used for generating QR code links, e.g. https://brandpilot.onrender.com)
PUBLIC_BASE_URL=http://localhost:8000

# Demo mode (enables demo credentials and reset endpoint; default: true)
DEMO_MODE=true

# Cron secret for securing POST /cron/expiry (must match X-Cron-Secret header)
CRON_SECRET=

# Expiry check interval for in-process background scheduler (default: 60 minutes)
EXPIRY_CHECK_INTERVAL_MINUTES=60
